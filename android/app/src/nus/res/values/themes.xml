<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nus_canvas">#F5F7FB</color>
    <!-- Always light, as on iOS (`preferredColorScheme(.light)`). -->
    <style name="Theme.Nus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/nus_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
